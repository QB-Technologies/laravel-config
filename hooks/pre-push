#!/bin/bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Exit when any command fails
set -e

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${HOOK_DIR}/_lib" ]; then
    . "${HOOK_DIR}/_lib"
else
    echo -e "${RED}❌ _lib not found!${NC}"
    exit 1
fi

echo -e "${YELLOW}Running pre-push hooks...${NC}"

# The files this push would send. A pre-push hook runs after the commit, so the
# index already matches HEAD and `git diff --cached` comes back empty: every check
# that used it was passing without looking at anything.
PUSH_FILES=""
OLDEST_UNPUSHED=$(git rev-list HEAD --not --remotes 2>/dev/null | tail -1)

if [ -n "$OLDEST_UNPUSHED" ]; then
    if git rev-parse --verify --quiet "${OLDEST_UNPUSHED}^" >/dev/null 2>&1; then
        PUSH_BASE="${OLDEST_UNPUSHED}^"
    else
        # Root commit, so diff against the empty tree.
        PUSH_BASE=$(git hash-object -t tree /dev/null)
    fi

    PUSH_FILES=$(git diff --name-only --diff-filter=d "$PUSH_BASE" HEAD)
fi

PUSH_PHP_FILES=$(printf '%s\n' "$PUSH_FILES" | grep '\.php$' | tr '\n' ' ' || true)
PUSH_JS_FILES=$(printf '%s\n' "$PUSH_FILES" | grep '\.js$' | tr '\n' ' ' || true)

# Function to display error
display_error() {
    echo -e "${RED}❌ $1${NC}"
    exit 1
}

# Function to check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

hooks_load_composer_scripts

# Directory Structure Validation
validate_directory_structure() {
    echo "📁 Validating project structure..."

    # "path|what lives there", in a plain indexed array. Associative arrays need
    # bash 4, and macOS ships 3.2, where the subscripts are arithmetic-evaluated
    # instead: "app/Providers" reads as a division, errors, and unwinds the whole
    # function without tripping set -e. That made this check pass silently.
    local required_directories=(
        "domain|domain files"
        "app/Providers|Provider files (*Provider.php)"
        "database/migrations|Migration files"
        "database/seeders|Seeder files (*Seeder.php)"
        "database/factories|Factory files (*Factory.php)"
        "tests|Test files (*Test.php)"
    )

    local entry dir description
    for entry in "${required_directories[@]}"; do
        dir="${entry%%|*}"
        description="${entry#*|}"

        if [ ! -d "$dir" ]; then
            display_error "Missing required directory: $dir ($description)"
        fi
    done
}

# File Location Validation
validate_file_locations() {
    echo "📍 Validating file locations..."

    # Check Migration naming
    find database/ -name "*.php" -path "database/migrations/*" 2>/dev/null | while read file; do
        if ! [[ $(basename "$file") =~ ^[0-9]{4}_[0-9]{2}_[0-9]{2}_[0-9]{6}_.*\.php$ ]]; then
            display_error "Invalid migration filename format: $file"
        fi
    done
}

# Check for unnecessary files
check_unnecessary_files() {
    echo "🧹 Checking for unnecessary files..."

    # Match what the push contains rather than whatever sits in the working tree.
    # An .idea directory that git ignores is nobody's business here, and the two
    # editor patterns never matched anything before this: find -name does not take
    # a trailing slash.
    local unnecessary='(^|/)(\.DS_Store|Thumbs\.db|npm-debug\.log|yarn-debug\.log|yarn-error\.log)$|(^|/)\.(idea|vscode)/|\.(log|swp|swo|swap|tmp|temp)$|~$'
    local found_files

    found_files=$(printf '%s\n' "$PUSH_FILES" | grep -E "$unnecessary" || true)

    if [ -n "$found_files" ]; then
        echo "Found unnecessary files:"
        echo "$found_files"
        display_error "Please remove unnecessary files"
    fi
}

# Run base checks
if [ ! -f "artisan" ]; then
    display_error "Not a Laravel project root directory!"
fi

# Run PHP syntax check
echo "🔍 Checking PHP syntax..."
for FILE in $PUSH_PHP_FILES; do
    if [ -f "$FILE" ]; then
        hooks_run_php -l "$FILE" >/dev/null 2>&1 || display_error "PHP syntax error in $FILE"
    fi
done

# Run PHP CS Fixer
if hooks_vendor_bin_exists php-cs-fixer; then
    echo "🧹 Running PHP CS Fixer..."
    hooks_run_check cs php-cs-fixer fix --dry-run --diff || display_error "PHP CS Fixer found issues"
fi

# Run PHPStan/Larastan
if hooks_vendor_bin_exists phpstan; then
    echo "🔍 Running PHPStan..."
    hooks_run_check phpstan phpstan analyse --memory-limit=1024M || display_error "PHPStan found issues"
fi

# Run Rector
if hooks_vendor_bin_exists rector; then
    echo "🔍 Running Rector..."
    hooks_run_check rector rector --dry-run || display_error "Rector found issues"
fi

# Run PHPCPD (copy-paste detection)
if hooks_vendor_bin_exists phpcpd; then
    echo "📋 Running PHPCPD..."
    hooks_run_check phpcpd phpcpd --min-lines 10 --min-tokens 70 --suffix .php domain/ || display_error "PHPCPD found duplicated code"
fi

# Run ESLint for JavaScript
if [ ! -z "$PUSH_JS_FILES" ] && command_exists "eslint"; then
    echo "🔍 Running ESLint..."
    ./node_modules/.bin/eslint $PUSH_JS_FILES || display_error "ESLint found issues"
fi

# Run Prettier for JavaScript
if [ ! -z "$PUSH_JS_FILES" ] && command_exists "prettier"; then
    echo "🎨 Running Prettier..."
    ./node_modules/.bin/prettier --check $PUSH_JS_FILES || display_error "Prettier found formatting issues"
fi

# Check .env file protection
if printf '%s\n' "$PUSH_FILES" | grep -qE '(^|/)\.env$'; then
    display_error ".env file cannot be pushed"
fi

# Check tests
#if command_exists "./vendor/bin/sail"; then
#    ./vendor/bin/sail test || display_error "Tests failed"
#elif command_exists "./vendor/bin/pest"; then
#    ./vendor/bin/pest || display_error "Tests failed"
#elif command_exists "./vendor/bin/phpunit"; then
#    ./vendor/bin/phpunit || display_error "Tests failed"
#fi

# Check migration status
echo "📊 Checking migration status..."
hooks_run_artisan migrate:status || display_error "Migration status check failed"

# Run all structural validations
validate_directory_structure
validate_file_locations
check_unnecessary_files

echo -e "${GREEN}✅ All pre-push hooks passed!${NC}"
exit 0
