{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "quboticlabs/php-cs-fixer",
    "type": "library",
    "description": "Shared PHP tool configurations (PHP-CS-Fixer, PHPStan, Rector) for company projects",
    "keywords": [
        "php-cs-fixer",
        "phpstan",
        "rector",
        "code-quality",
        "coding-standards"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^1.10",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Quboticlabs\\PhpToolConfigs\\": "src/"
        }
    },
    "bin": [
        "bin/install-hooks"
    ],
    "scripts": {
        "install-hooks": "Quboticlabs\\PhpToolConfigs\\InstallHooks::install"
    },
    "extra": {
        "configs": {
            "php-cs-fixer": "config/.php-cs-fixer.php",
            "phpstan": "config/.phpstan.neon",
            "rector": "config/rector.php"
        }
    }
}

