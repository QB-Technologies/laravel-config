{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "qb-technologies/laravel-config",
    "version": "1.0.3",
    "type": "library",
    "description": "🎯 Standardized PHP code quality configurations for PHP-CS-Fixer, PHPStan, and Rector. Share consistent coding standards across all your projects.",
    "keywords": [
        "php-cs-fixer",
        "phpstan",
        "rector",
        "code-quality",
        "coding-standards",
        "laravel",
        "php",
        "static-analysis",
        "code-formatting"
    ],
    "license": "MIT",
    "homepage": "https://github.com/QB-Technologies/laravel-config",
    "support": {
        "issues": "https://github.com/QB-Technologies/laravel-config/issues",
        "source": "https://github.com/QB-Technologies/laravel-config"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^1.10",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "QBTechnologies\\LaravelConfig\\": "src/"
        }
    },
    "bin": [
        "bin/install-hooks"
    ],
    "scripts": {
        "install-hooks": "QBTechnologies\\LaravelConfig\\InstallHooks::install"
    },
    "extra": {
        "configs": {
            "php-cs-fixer": "config/.php-cs-fixer.php",
            "phpstan": "config/.phpstan.neon",
            "rector": "config/rector.php"
        }
    }
}

